# Only accessible from Server Components, Server Actions, and proxy.ts
BACKEND_API_URL=http://localhost:5000
# Must match the backend's JWT_SECRET so proxy.ts can verify access tokens.
JWT_SECRET=replace-with-backend-jwt-secret

# Accessible from the client too
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000
# Must be a real Stripe publishable key from the same account as the backend's
# STRIPE_SECRET_KEY (Dashboard -> Developers -> API keys). The placeholder is
# rejected by Stripe with a 401.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
